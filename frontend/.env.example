# Same Mixpanel project token as the backend (used for page views + identity)
VITE_MIXPANEL_TOKEN=
# Leave empty in dev (Vite proxies /api to FastAPI). Set to your API URL in production.
VITE_API_URL=
# % of sessions to record with Mixpanel Session Replay (0-100)
VITE_MIXPANEL_REPLAY_PERCENT=100
# Only for EU/IN data residency, e.g. https://api-eu.mixpanel.com
VITE_MIXPANEL_API_HOST=
