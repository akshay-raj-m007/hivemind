# Mixpanel project token (Project Settings -> Access Keys -> Project Token)
MIXPANEL_TOKEN=
# Use api-eu.mixpanel.com or api-in.mixpanel.com if your project uses EU/IN data residency
MIXPANEL_API_HOST=api.mixpanel.com

# Key required to open the in-app Analytics dashboard (sent as X-Admin-Key header)
ADMIN_KEY=change-me

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Set to true ONLY when running behind a reverse proxy/load balancer you control
# (nginx, Render, Railway, etc.) so X-Forwarded-For is trusted for the client IP.
TRUST_PROXY=false

# Local dev: requests come from 127.0.0.1, which can't be geolocated.
# When true, private IPs are resolved to this machine's public IP instead.
DEV_RESOLVE_PUBLIC_IP=true

# ---- Hive tests ----
# Free key from https://build.nvidia.com (Get API Key). Leave empty to use template paragraphs.
NVIDIA_API_KEY=
NVIDIA_CHAT_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Eyes Test: Autism Research Centre allows non-commercial research use (Hive is a non-commercial showcase)
ENABLE_RMET=true

# ---- Deployment ----
# Extra allowed origins as a regex (e.g. Vercel preview deployments)
CORS_ORIGIN_REGEX=
# Where the SQLite analytics database lives (Render: use a path on a persistent disk if you add one)
DB_PATH=analytics.db
