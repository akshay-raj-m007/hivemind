{
  "big-five": {
    "E": {
      "higher": [
        {
          "source": "big5",
          "text": "Extraverts enjoy interacting with people, and are often perceived as energetic."
        },
        {
          "source": "big5",
          "text": "They tend to be enthusiastic and action-oriented."
        }
      ],
      "lower": [
        {
          "source": "big5",
          "text": "Introverts need less stimulation and more time alone than extraverts."
        },
        {
          "source": "big5",
          "text": "They tend to seem quiet, low-key, deliberate, and less involved in the social world."
        }
      ],
      "average": [
        {
          "source": "big5",
          "text": "Generally, people are a combination of extraversion and introversion"
        }
      ]
    },
    "A": {
      "higher": [
        {
          "source": "big5",
          "text": "Agreeable individuals value getting along with others."
        },
        {
          "source": "big5",
          "text": "They are generally considerate, kind, generous, trusting and trustworthy, helpful, and willing to compromise their interests with others."
        }
      ],
      "lower": [
        {
          "source": "big5",
          "text": "Disagreeable people are often competitive or challenging"
        }
      ],
      "average": []
    },
    "C": {
      "higher": [
        {
          "source": "big5",
          "text": "Conscientiousness is a tendency to be self-disciplined, act dutifully, and strive for achievement against measures or outside expectations."
        },
        {
          "source": "big5",
          "text": "High conscientiousness indicates a preference for planned rather than spontaneous behaviour."
        }
      ],
      "lower": [
        {
          "source": "big5",
          "text": "Low conscientiousness is associated with flexibility and spontaneity"
        }
      ],
      "average": []
    },
    "ES": {
      "higher": [
        {
          "source": "big5",
          "text": "less neurotic individuals are less easily upset and are less emotionally reactive."
        },
        {
          "source": "big5",
          "text": "They tend to be calm, emotionally stable, and free from persistent negative feelings."
        }
      ],
      "lower": [
        {
          "source": "big5",
          "text": "emotionally volatile, emotionally reactive and vulnerable to stress"
        }
      ],
      "average": []
    },
    "O": {
      "higher": [
        {
          "source": "big5",
          "text": "People who are open to experience are intellectually curious, open to emotion, sensitive to beauty, and willing to try new things."
        },
        {
          "source": "big5",
          "text": "They tend to be, when compared to closed people, more creative and more aware of their feelings."
        }
      ],
      "lower": [
        {
          "source": "big5",
          "text": "those with low openness want to be fulfilled by persevering and are characterised as pragmatic and data-driven"
        }
      ],
      "average": []
    },
    "general": [
      {
        "source": "big5",
        "text": "These traits are not black and white; each one is a spectrum, with personality varying continuously across each of these dimensions"
      }
    ]
  },
  "jungian-type": {
    "E": [
      {
        "source": "mbti",
        "text": "Extraversion means literally outward-turning and introversion, inward-turning."
      }
    ],
    "I": [
      {
        "source": "mbti",
        "text": "Extraversion means literally outward-turning and introversion, inward-turning."
      }
    ],
    "S": [
      {
        "source": "mbti",
        "text": "people who prefer sensing are more likely to trust information that is in the present, tangible, and concrete."
      },
      {
        "source": "mbti",
        "text": "They tend to distrust hunches."
      }
    ],
    "N": [
      {
        "source": "mbti",
        "text": "Those who prefer intuition tend to trust information that is associated with other information, either remembered or discovered from context."
      }
    ],
    "T": [
      {
        "source": "mbti",
        "text": "Those who prefer thinking tend to decide things from a more detached standpoint."
      }
    ],
    "F": [
      {
        "source": "mbti",
        "text": "Those who prefer feeling tend to come to decisions by associating or empathizing with the situation."
      }
    ],
    "J": [
