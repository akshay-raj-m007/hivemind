  "dimensions": {
    "IE": {
      "poles": [
        "I",
        "E"
      ],
      "names": {
        "I": "Introversion",
        "E": "Extraversion"
      },
      "definition": "Sometimes described as a person's orientation, either oriented inside themselves or to the outside world. Other times the focus is put more explicitly on social interaction, with some claiming that social interactions wear out introverts whereas social interaction raises the energy level in extroverts."
    },
    "SN": {
      "poles": [
        "S",
        "N"
      ],
      "names": {
        "S": "Sensing",
        "N": "Intuition"
      },
      "definition": "Defined as how a person takes in information by Myers-Briggs, who said that sensors pay attention to the five senses while intuitives pay attention to possibilities."
    },
    "FT": {
      "poles": [
        "F",
        "T"
      ],
      "names": {
        "F": "Feeling",
        "T": "Thinking"
      },
      "definition": "Has been defined as what a person values and what they base their decisions on: either interpersonal considerations or dispassionate logic."
    },
    "JP": {
      "poles": [
        "J",
        "P"
      ],
      "names": {
        "J": "Judging",
        "P": "Perceiving"
      },
      "definition": "Individuals who prefer a structured lifestyle are said to lean Judging; individuals who prefer a flexible lifestyle are said to lean Perceiving."
    }
  },
  "scoring": {
    "method": "Each item is scored 1-5 from left to right. For each dimension, items are oriented so that a higher value always points to the same pole, then summed (range 8-40). 24 is the midpoint.",
    "midpoint": 24
  },
