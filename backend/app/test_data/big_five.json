  "factors": {
    "E": {
      "name": "Extraversion",
      "definition": "Implies an energetic approach toward the social and material world and includes traits such as sociability, activity, assertiveness, and positive emotionality.",
      "high": [
        "talkative",
        "assertive",
        "active",
        "energetic",
        "outgoing",
        "outspoken"
      ],
      "low": [
        "quiet",
        "reserved",
        "shy",
        "silent",
        "retiring"
      ]
    },
    "A": {
      "name": "Agreeableness",
      "definition": "Contrasts a prosocial and communal orientation towards others with antagonism and includes traits such as altruism, tender-mindedness, trust, and modesty.",
      "high": [
        "sympathetic",
        "kind",
        "appreciative",
        "affectionate",
        "soft-hearted",
        "warm"
      ],
      "low": [
        "fault-finding",
        "stern",
        "cold"
      ]
    },
    "C": {
      "name": "Conscientiousness",
      "definition": "Describes socially prescribed impulse control that facilitates task- and goal-directed behavior, such as thinking before acting, delaying gratification, following norms and rules, and planning, organizing, and prioritizing tasks.",
      "high": [
        "organized",
        "thorough",
        "planful",
        "efficient",
        "responsible",
        "reliable"
      ],
      "low": [
        "careless",
        "disorderly",
        "forgetful"
      ]
    },
    "ES": {
      "name": "Emotional Stability",
      "note": "IPIP scores this factor as Emotional Stability, the opposite pole of Neuroticism.",
      "definition": "Contrasts emotional stability and even-temperedness with negative emotionality, such as feeling anxious, nervous, sad, and tense.",
      "high": [
        "stable",
        "calm",
        "contented"
      ],
      "low": [
        "tense",
        "anxious",
        "nervous",
        "moody",
        "worrying",
        "touchy"
      ]
    },
    "O": {
      "name": "Openness / Intellect",
      "note": "IPIP labels this factor Intellect/Imagination; John et al. call it Openness to Experience.",
      "definition": "Describes the breadth, depth, originality, and complexity of an individual's mental and experiential life.",
      "high": [
        "wide interests",
        "imaginative",
        "intelligent",
        "original",
        "insightful",
        "curious"
      ],
      "low": [
        "commonplace",
        "narrow interests"
      ]
    }
  },
