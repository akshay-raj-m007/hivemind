  "types": {
    "R": {
      "name": "Realistic",
      "work": "Work involves designing, building, or repairing of equipment, materials, or structures, engaging in physical activity, or working outdoors.",
      "occupations": "Realistic occupations are often associated with engineering, mechanics and electronics, construction, woodworking, transportation, machine operation, agriculture, animal services, physical or manual labor, athletics, or protective services."
    },
    "I": {
      "name": "Investigative",
      "work": "Work involves studying and researching non-living objects, living organisms, disease or other forms of impairment, or human behavior.",
      "occupations": "Investigative occupations are often associated with physical, life, medical, or social sciences, and can be found in the fields of humanities, mathematics/statistics, information technology, or health care service."
    },
    "A": {
      "name": "Artistic",
      "work": "Work involves creating original visual artwork, performances, written works, food, or music for a variety of media, or applying artistic principles to the design of various objects and materials.",
      "occupations": "Artistic occupations are often associated with visual arts, applied arts and design, performing arts, music, creative writing, media, or culinary art."
    },
    "S": {
      "name": "Social",
      "work": "Work involves helping, teaching, advising, assisting, or providing service to others.",
      "occupations": "Social occupations are often associated with social, health care, personal service, teaching/education, or religious activities."
    },
    "E": {
      "name": "Enterprising",
      "work": "Work involves managing, negotiating, marketing, or selling, typically in a business setting, or leading or advising people in political and legal situations.",
      "occupations": "Enterprising occupations are often associated with business initiatives, sales, marketing/advertising, finance, management/administration, professional advising, public speaking, politics, or law."
    },
    "C": {
      "name": "Conventional",
      "work": "Work involves following procedures and regulations to organize information or data, typically in a business setting.",
      "occupations": "Conventional occupations are often associated with office work, accounting, mathematics/statistics, information technology, finance, or human resources."
    }
  },
